# Hosted Supabase project (driftwatch), used by `vite build` (Vercel). Same values as .env.development;
# Vite reads .env.development only for `npm run dev`, and .env.local is git-ignored, so without this file a
# deployed build has no Supabase URL and renders a blank page.
# The publishable key is public by design: row-level security protects the data.
# Never put the secret / service_role key here or anywhere in frontend/.
VITE_SUPABASE_URL=https://iltbflwrlybklasqpudg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_L7pf3WwT_2A2qzRK_YLhhQ_dVcTbbz9
VITE_ENABLE_PHONE_AUTH=false

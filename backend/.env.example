PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://tc:tc@localhost:5432/toothbrush_connect
REDIS_URL=redis://localhost:6379
SESSION_SECRET=

# Phone OTP login
SMS_OTP_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Photon Spectrum (messaging agent). Inbound arrives over the SDK stream, so no webhook secret is needed.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Supabase (used by src/db/client.ts). Project Settings → API. The service-role key bypasses
# row-level security: server only, never in the frontend or in git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

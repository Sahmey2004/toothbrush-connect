PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://tc:tc@localhost:5432/toothbrush_connect
REDIS_URL=redis://localhost:6379
SESSION_SECRET=

# Phone OTP login
SMS_OTP_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Photon Spectrum (messaging agent). Inbound arrives over the SDK stream, so no webhook secret is needed.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Supabase, used by the messaging agent (src/agent/config.ts). Project Settings → API.
# SUPABASE_SECRET_KEY is the secret key (sb_secret_…) or legacy service_role key. It bypasses
# row-level security: server only, never in the frontend or in git.
SUPABASE_URL=https://iltbflwrlybklasqpudg.supabase.co
SUPABASE_SECRET_KEY=
# Website address used in links inside texts. People open them on their phones, so it's the public site;
# unset means https://toothbrush-connect.vercel.app. Photon mode refuses localhost.
SITE_URL=https://toothbrush-connect.vercel.app

# Edge function secrets. Locally: `supabase functions serve --env-file supabase/functions/.env`.
# Hosted: `supabase secrets set --env-file supabase/functions/.env`.
# Leave the Photon values empty to run the agent in dry-run mode (messages are only logged).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_WEBHOOK_SECRET=
SITE_URL=https://toothbrush-connect.vercel.app

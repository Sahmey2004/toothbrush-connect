# Read by `supabase start` for env() values in config.toml.
# Local dev only needs placeholders: phone sign-in uses the test numbers in [auth.sms.test_otp].
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=local
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=local
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=local

# Google sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
